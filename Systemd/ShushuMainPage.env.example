# Copy to /etc/ShushuMainPage.env and restrict its permissions to 600.
# Required only when initializing a new database (at least 12 characters).
# Values containing spaces or # should be enclosed in double quotes.
# This file is read by systemd, not a shell: do not use export or substitutions.
SHUSHU_ADMIN_PASSWORD=

SERVER_PORT=12339
GUNICORN_WORKERS=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=60
GUNICORN_LOG_LEVEL=info

# Enable when the site is served over HTTPS.
SESSION_COOKIE_SECURE=false

# Leave unset to use the persistent Data/SecretKey.txt.
# SHUSHU_SECRET_KEY=
