.git/
.gitignore
.vscode/
.idea/
.DS_Store

# Python 缓存
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# 日志与临时文件
*.log
*.db-wal
*.db-shm

# 与本镜像无关的仓库文件
ReadMe.md
